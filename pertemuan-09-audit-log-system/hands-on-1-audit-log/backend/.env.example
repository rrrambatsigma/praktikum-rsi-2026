# Salin file ini menjadi .env lalu sesuaikan.
# Jangan commit file .env yang berisi kredensial asli.

PORT=3002
CORS_ORIGIN=http://localhost:5174
NODE_ENV=development

DB_SERVER=localhost
DB_PORT=1433
DB_USER=praktikum_user
DB_PASSWORD=ubah_password_database
DB_NAME=review_kantin
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Autentikasi (cookie httpOnly + JWT HS256).
# Wajib diisi. Untuk praktikum, buat nilai acak sendiri, misalnya:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ubah_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=kantin_session_ho2
BCRYPT_SALT_ROUNDS=10
