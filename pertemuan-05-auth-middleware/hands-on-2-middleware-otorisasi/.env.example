# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# Jangan commit file .env yang berisi kredensial asli.

DB_SERVER=localhost
DB_PORT=1433
DB_USER=praktikum_user
DB_PASSWORD=Praktikum2026!
DB_NAME=review_kantin

# Untuk SQL Server lokal biasanya: encrypt=false, trustServerCertificate=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Rahasia penanda tangani JWT. WAJIB diganti di aplikasi nyata —
# siapa pun yang tahu string ini bisa membuat token palsu untuk role apa saja.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=2h

# Biaya bcrypt (jumlah iterasi). 10 cukup untuk praktikum, naikkan ke 12+ di produksi.
BCRYPT_SALT_ROUNDS=10